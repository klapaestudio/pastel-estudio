// Pastel Studio — modelo de datos
// Nota: SQLite (motor de desarrollo) no soporta enums nativos de Prisma,
// por eso los campos de "tipo cerrado" son String y se validan en la capa de app
// (ver server/src/lib/enums.ts). El datasource se puede cambiar a Postgres
// cambiando `provider` y `DATABASE_URL` sin tocar el resto del schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Usuarios y permisos (4.15) ──────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  nombre       String
  role         String // ADMIN | VENTAS | TALLER | FINANZAS | CLIENTE
  activo       Boolean   @default(true)
  contactoId   String? // solo para role=CLIENTE: vincula al Contacto/portal
  contacto     Contacto? @relation(fields: [contactoId], references: [id])
  createdAt    DateTime  @default(now())
}

// ── Configuración general ───────────────────────────────────────────────

model ConfiguracionGeneral {
  id                              String @id @default("default")
  intervaloRecontactoDefaultMeses Int    @default(6)
}

// ── CRM: Contacto unificado (prospecto → cliente) (4.3, 4.5) ────────────

model Contacto {
  id    String @id @default(cuid())
  etapa String @default("PROSPECTO") // PROSPECTO | CLIENTE

  // Datos generales
  nombre    String
  telefono  String?
  ciudad    String?
  provincia String?
  perfil    String? // PARTICULAR | ARQUITECTO | DISENADOR
  origen    String  @default("WHATSAPP_INSTAGRAM") // TIENDA_NUBE | WHATSAPP_INSTAGRAM
  notas     String?

  // Campos de Prospecto (4.5.A)
  tagProductoServicio    String? // texto libre: qué está pidiendo
  telaColor              String? // visible directo en tabla
  monto                  Float?    @default(0)
  fechaPrimerContacto    DateTime?
  fechaEnvioPresupuesto  DateTime? // dispara conteo de follow up
  estado                 String    @default("A_PRESUPUESTAR")
  // A_PRESUPUESTAR | PRESU_ENVIADO | PRESU_APROBADO | PRESU_RECHAZADO | PRESU_POSTERGADO
  followUpRealizado      Boolean   @default(false)
  followUpRealizadoFecha DateTime?
  followUpManualFecha    DateTime?

  // Campos de Cliente (4.5.B)
  fechaCierrePresupuesto   DateTime?
  fechaEntrega             DateTime?
  fechaUltimaCompra        DateTime?
  intervaloRecontactoMeses Int? // null = usa el default general
  ultimoContactoRecontacto DateTime?
  recontactoMarcadoFecha   DateTime? // reinicia el conteo sin compra nueva

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  etiquetas      Etiqueta[]
  presupuestos   Presupuesto[]
  cobros         Cobro[]
  tareas         TareaAgenda[]
  archivos       ArchivoProyecto[]
  etapasProyecto EtapaProyecto[]
  users          User[]

  @@index([etapa])
  @@index([estado])
}

// Etiqueta transversal: Colección / Personalizado / Arquitectura (+línea/servicio) (4.1, 4.3)
model Etiqueta {
  id         String   @id @default(cuid())
  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  tipoProducto String // COLECCION | PERSONALIZADO | ARQUITECTURA
  linea        String? // RESIDENCIAL | COMERCIAL (solo ARQUITECTURA)
  servicio     String? // ASESORAMIENTO | PROYECTO_INTEGRAL | PROYECTO_OBRA (solo ARQUITECTURA)

  @@index([contactoId])
  @@index([tipoProducto])
}

// ── Presupuestador (4.6): objetos (Colección/Personalizado) y Arquitectura ─

model Presupuesto {
  id         String    @id @default(cuid())
  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  tipo     String // OBJETO_COLECCION | OBJETO_PERSONALIZADO | ARQUITECTURA
  titulo   String
  linea    String? // ARQUITECTURA
  servicio String? // ARQUITECTURA

  estado       String  @default("BORRADOR") // BORRADOR | ENVIADO | APROBADO | RECHAZADO
  envioTipo    String  @default("ESTIMATIVO") // ESTIMATIVO | DEFINIDO
  envioCosto   Float   @default(0)
  envioEstado  String  @default("PENDIENTE") // PENDIENTE | COORDINADO | DESPACHADO (solo relevante si estado=APROBADO)
  plantillaPdf String  @default("CLASICA") // CLASICA | MINIMAL | ACENTO
  notas        String?

  fecha     DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Arquitectura (4.6): alcance del proyecto — objetos personalizados no lo usan
  alcance String?

  items              PresupuestoItem[]
  valoresAdicionales ValorAdicional[]

  @@index([contactoId])
  @@index([tipo])
}

// Filas de costo agregables a mano por el equipo — "valores a considerar" en objetos
// personalizados, "costes del proyecto" en Arquitectura (4.6).
model ValorAdicional {
  id            String      @id @default(cuid())
  presupuestoId String
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  concepto      String
  monto         Float       @default(0)
  orden         Int         @default(0)

  @@index([presupuestoId])
}

model PresupuestoItem {
  id            String      @id @default(cuid())
  presupuestoId String
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  orden         Int         @default(0)

  producto String
  medidas  String?
  tela     String?
  color    String?

  // Costo (interno — objetos)
  cantidadTela       Float  @default(0)
  precioTelaMetro    Float  @default(0)
  manoObraEstructura Float  @default(0)
  manoObraTapiceria  Float  @default(0)
  manoObraEstado     String @default("ESTIMATIVO") // DEFINIDO | ESTIMATIVO
  materialesCosto    Float  @default(0)
  costoDiseno        Float  @default(0) // solo PERSONALIZADO

  // Costo (interno — arquitectura, mismo item genérico)
  honorariosCosto Float @default(0)
  gastosVarios    Float @default(0)

  // Venta
  unidades     Float @default(1)
  precioUnidad Float @default(0)

  // Vista para talleres/proveedores (4.14)
  observaciones        String?
  imagenReferenciaData String? // data URL

  @@index([presupuestoId])
}

// ── Proveedores (4.8) ─────────────────────────────────────────────────────

model Proveedor {
  id       String  @id @default(cuid())
  nombre   String
  tipo     String // MATERIAL | MANO_OBRA | TRANSPORTE
  ciudad   String?
  telefono String?
  contacto String?
  notas    String?

  materiales      Material[]
  manoObraTarifas ManoObraTarifa[]
  pagos           PagoProveedor[]

  createdAt DateTime @default(now())
}

// Pagos pendientes/realizados a proveedores — alimenta el panel de control 4.2 ("a quién le debe ella")
model PagoProveedor {
  id          String    @id @default(cuid())
  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  concepto         String
  monto            Float     @default(0)
  fechaVencimiento DateTime
  pagada           Boolean   @default(false)
  fechaPago        DateTime?

  createdAt DateTime @default(now())

  @@index([proveedorId])
  @@index([pagada])
}

model Material {
  id          String     @id @default(cuid())
  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  nombre           String
  unidad           String @default("unidad") // m, kg, unidad, etc.
  costoActualizado Float  @default(0)
  stockEstado      String @default("HAY_STOCK") // HAY_STOCK | QUEDANDO_SIN_STOCK | SIN_STOCK
  stockCantidad    Float? @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  productoEstandarUso ProductoEstandarMaterial[]

  @@index([proveedorId])
  @@index([stockEstado])
}

model ManoObraTarifa {
  id          String     @id @default(cuid())
  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])
  tipoTrabajo String
  costo       Float      @default(0)
  updatedAt   DateTime   @updatedAt
}

// ── Productos estándar / Colección (4.7) ─────────────────────────────────

model ProductoEstandar {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String?
  medidas     String?

  manoObraEstructura Float @default(0)
  manoObraTapiceria  Float @default(0)

  moldeFileNombre String?
  moldeFileData   String? // data URL (demo local storage)

  precioVenta Float @default(0)

  materiales ProductoEstandarMaterial[]
  stock      StockProducto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductoEstandarMaterial {
  id                 String           @id @default(cuid())
  productoEstandarId String
  producto           ProductoEstandar @relation(fields: [productoEstandarId], references: [id], onDelete: Cascade)
  materialId         String
  material           Material         @relation(fields: [materialId], references: [id])
  cantidad           Float            @default(0)

  @@index([productoEstandarId])
}

model StockProducto {
  id                 String           @id @default(cuid())
  productoEstandarId String
  producto           ProductoEstandar @relation(fields: [productoEstandarId], references: [id], onDelete: Cascade)

  cantidad           Float   @default(0)
  tela               String?
  embalaje           String  @default("SIMPLE") // DOBLE | SIMPLE
  mensajePredefinido String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([productoEstandarId])
}

// ── Mensajes prearmados (4.9) ────────────────────────────────────────────

model MensajeCategoria {
  id     String @id @default(cuid())
  nombre String @unique
  orden  Int    @default(0)

  mensajes Mensaje[]
}

model Mensaje {
  id          String           @id @default(cuid())
  categoriaId String
  categoria   MensajeCategoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  titulo      String
  texto       String // admite variables {{nombre}}, {{producto}}, {{fecha}}, {{tela}}
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoriaId])
}

// ── Facturación (4.10) ────────────────────────────────────────────────────

model Cobro {
  id         String   @id @default(cuid())
  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id])

  concepto      String
  categoria     String? // para dashboard: tipo de producto/servicio
  gananciaTotal Float   @default(0)

  createdAt DateTime @default(now())
  cuotas    Cuota[]
}

model Cuota {
  id      String @id @default(cuid())
  cobroId String
  cobro   Cobro  @relation(fields: [cobroId], references: [id], onDelete: Cascade)

  numero Int
  fecha  DateTime
  monto  Float    @default(0)
  costos Float    @default(0)
  gastos Float    @default(0)
  pagada Boolean  @default(false)

  comprobanteEmitido    Boolean @default(false)
  comprobanteTipo       String?
  comprobantePuntoVenta String?
  comprobanteNumero     String?

  @@index([cobroId])
}

// Gastos operativos generales y retiros de socias — no forman parte del modelo de
// negocio de la sección 4, pero se preservan porque la operación real del estudio
// ya los registra (migrados desde la v1 de la app) y alimentan el dashboard financiero.
model GastoGeneral {
  id        String   @id @default(cuid())
  concepto  String
  categoria String?
  monto     Float    @default(0)
  fecha     DateTime
  createdAt DateTime @default(now())
}

model RetiroSocia {
  id        String   @id @default(cuid())
  socia     String
  monto     Float    @default(0)
  notas     String?
  fecha     DateTime
  createdAt DateTime @default(now())
}

model ArcaConfig {
  id                String  @id @default("default")
  cuitEstudio       String?
  cuentaVinculada   Boolean @default(false)
  puntoVentaDefault String?
}

// ── Agenda (4.12) ─────────────────────────────────────────────────────────

model TareaAgenda {
  id         String    @id @default(cuid())
  titulo     String
  tipo       String    @default("INTERNA") // INTERNA | CLIENTE_RESERVABLE
  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  fechaInicio DateTime
  fechaFin    DateTime
  ubicacion   String?
  notas       String?

  cronometroEstado   String    @default("PARADO") // PARADO | CORRIENDO | PAUSADO
  cronometroSegundos Int       @default(0)
  cronometroInicioTs DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactoId])
}

model FranjaBloqueada {
  id         String   @id @default(cuid())
  fecha      DateTime
  horaInicio String
  horaFin    String
  motivo     String?
}

// ── Portal de cliente de arquitectura (4.13) ─────────────────────────────

model ArchivoProyecto {
  id         String   @id @default(cuid())
  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  nombre    String
  tipo      String? // plano | documento | otro
  fileData  String? // data URL (demo local storage)
  createdAt DateTime @default(now())

  @@index([contactoId])
}

model EtapaProyecto {
  id         String   @id @default(cuid())
  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  nombre     String
  orden      Int       @default(0)
  completada Boolean   @default(false)
  fecha      DateTime?

  @@index([contactoId])
}
